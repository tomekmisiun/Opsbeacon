#!/usr/bin/env sh
# Enforces Conventional Commits and the no-tool-attribution rule for every commit.
# Installed via: git config core.hooksPath scripts/git-hooks
MSG_FILE="$1"
SUBJECT="$(head -n 1 "$MSG_FILE")"

# Allow merge/revert/fixup commits generated by git itself
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

# 1) Conventional Commits subject
if ! printf '%s' "$SUBJECT" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: .+'; then
  echo "✗ commit-msg: subject must follow Conventional Commits:" >&2
  echo "    type(scope): imperative summary   e.g. feat(parser): add offer adapter [T-012]" >&2
  echo "  allowed types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
if [ ${#SUBJECT} -gt 72 ]; then
  echo "✗ commit-msg: subject is ${#SUBJECT} chars; keep it ≤72" >&2
  exit 1
fi

# 2) No tool attribution anywhere in the message
if grep -Eiq 'co-authored-by:|generated (with|by)|written (with|by)|🤖' "$MSG_FILE"; then
  echo "✗ commit-msg: tool attribution detected." >&2
  echo "  Project rule: no tool attribution in commits, comments, or PRs. Remove it." >&2
  exit 1
fi
exit 0
